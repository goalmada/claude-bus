#!/usr/bin/env node
import fs from 'node:fs';
import { runService, serviceState, configureService } from '../src/personal/service.js';
import { PersonalQueue } from '../src/personal/queue.js';
import { dashboardHandoff } from '../src/personal/projection.js';
import { approveCheck, runApprovedCheck } from '../src/personal/checks.js';
import { nativeClaude } from '../src/personal/claude.js';
import { dispatchNext } from '../src/personal/dispatcher.js';
import { workQueue } from '../src/personal/worker.js';
import { publishReadiness, publishProgress, coordinationView, coordinationSummary, reconcileCoordination } from '../src/personal/coordination.js';
import { pendingNotifications } from '../src/personal/notifications.js';
import { admissionStatus, reserveLaunch, attachExternalProcess, finalizeExternalLaunch } from '../src/personal/admission.js';
import * as coordinator from '../src/personal/coordinator.js';

const [action, id] = process.argv.slice(2);
const needsId = ['status', 'run', 'cancel', 'reconcile', 'resolve', 'verify', 'pause', 'resume', 'handoff', 'approve-check', 'check',
  'ready', 'progress', 'coordination', 'coord-approve', 'coord-deploy', 'coord-verify', 'launch-attach', 'launch-finalize'];
try {
  const queue = new PersonalQueue();
  if (needsId.includes(action) && !id) throw new Error('Task, subject or launch id required');
  let result;
  const input = () => JSON.parse(fs.readFileSync(0, 'utf8'));
  switch (action) {
    case 'result': if(!id)throw new Error('Task id required'); console.log(JSON.stringify(queue.readResult(id,input()))); process.exit(0); break;
    case 'service-config': console.log(JSON.stringify(configureService(queue,input()))); process.exit(0); break;
    case 'service-status': console.log(JSON.stringify(serviceState(queue))); process.exit(0); break;
    case 'serve': {
      const controller = new AbortController();
      process.once('SIGINT', () => controller.abort()); process.once('SIGTERM', () => controller.abort());
      let previous;
      await runService(queue, { signal:controller.signal, onState:state=>{const serialized=JSON.stringify(state);if(serialized!==previous){console.log(serialized);previous=serialized;}} });
      process.exit(0); break;
    }
    case 'dispatch': console.log(JSON.stringify(await dispatchNext(queue, nativeClaude(queue.root)))); process.exit(0); break;
    case 'work': {
      const controller = new AbortController();
      const stop = () => controller.abort();
      process.once('SIGINT', stop); process.once('SIGTERM', stop);
      try { console.log(JSON.stringify(await workQueue(queue, nativeClaude(queue.root), { ...input(), signal: controller.signal, onEvent: event => console.error(JSON.stringify(event)) }))); }
      finally { process.removeListener('SIGINT', stop); process.removeListener('SIGTERM', stop); }
      process.exit(0); break;
    }
    // Executor surface: a worker may publish readiness and progress. It has no approval,
    // deployment, verification, routing or acknowledgement command at all.
    case 'ready': console.log(JSON.stringify(publishReadiness(queue, id, input()), null, 2)); process.exit(0); break;
    case 'progress': console.log(JSON.stringify(publishProgress(queue, id, input()), null, 2)); process.exit(0); break;
    case 'coordination': console.log(JSON.stringify(coordinationView(queue, id), null, 2)); process.exit(0); break;
    case 'coordination-list': console.log(JSON.stringify(coordinationSummary(queue, { all: process.argv[3] === '--all' }), null, 2)); process.exit(0); break;
    case 'coordination-reconcile': console.log(JSON.stringify(reconcileCoordination(queue), null, 2)); process.exit(0); break;
    case 'notifications': console.log(JSON.stringify(pendingNotifications(queue, { includeDelivered: process.argv[3] !== '--undelivered' }), null, 2)); process.exit(0); break;
    case 'admission': console.log(JSON.stringify(admissionStatus(queue.snapshot()), null, 2)); process.exit(0); break;
    // Launch ledger: reserving cites either an approved routing policy plus the authorized
    // task identity, or a finite legacy external authorization.
    case 'launch-reserve': console.log(JSON.stringify(reserveLaunch(queue, input()), null, 2)); process.exit(0); break;
    case 'launch-attach': console.log(JSON.stringify(attachExternalProcess(queue, id, input()), null, 2)); process.exit(0); break;
    case 'launch-finalize': console.log(JSON.stringify(finalizeExternalLaunch(queue, id, input()), null, 2)); process.exit(0); break;
    // Coordinator surface: every command below requires the recorded role proof.
    case 'coord-approve': console.log(JSON.stringify(coordinator.approve(queue, id, input()), null, 2)); process.exit(0); break;
    case 'coord-deploy': console.log(JSON.stringify(coordinator.startDeployment(queue, id, input()), null, 2)); process.exit(0); break;
    case 'coord-verify': console.log(JSON.stringify(coordinator.recordVerification(queue, id, input()), null, 2)); process.exit(0); break;
    case 'coord-routing-policy': console.log(JSON.stringify(coordinator.setRoutingPolicy(queue, input()), null, 2)); process.exit(0); break;
    case 'coord-machine-capacity': console.log(JSON.stringify(coordinator.recordMachineCapacity(queue, input()), null, 2)); process.exit(0); break;
    case 'coord-authorize-external': console.log(JSON.stringify(coordinator.authorizeExternalLaunches(queue, input()), null, 2)); process.exit(0); break;
    case 'coord-concurrency': console.log(JSON.stringify(coordinator.setConcurrency(queue, input()), null, 2)); process.exit(0); break;
    case 'coord-notify-delivered': console.log(JSON.stringify(coordinator.confirmDelivery(queue, input()), null, 2)); process.exit(0); break;
    case 'coord-notify-ack': console.log(JSON.stringify(coordinator.acknowledge(queue, input()), null, 2)); process.exit(0); break;
    case 'approve-check': result = approveCheck(queue, id, input()); break;
    case 'check': result = await runApprovedCheck(queue, id); break;
    case 'handoff': console.log(JSON.stringify(dashboardHandoff(queue.get(id), input()), null, 2)); process.exit(0); break;
    case 'submit': result = queue.submit(input()); break;
    case 'list': result = queue.get().map(({ id, status, createdAt }) => ({ id, status, createdAt })); break;
    case 'status': {
      const { id: taskId, status, revision, owner, sourceTask, launchId, resultHash, reason } = queue.get(id);
      result = { id: taskId, status, revision, owner, sourceTask, launchId, resultHash, reason }; break;
    }
    case 'run': result = await queue.run(id, nativeClaude(queue.root)); break;
    case 'pause': result = queue.pause(id); break;
    case 'resume': result = queue.resume(id); break;
    case 'cancel': result = queue.cancel(id); break;
    case 'reconcile': result = queue.reconcile(id); break;
    case 'resolve': result = queue.resolveUncertain(id, input().evidence); break;
    case 'verify': result = queue.verify(id, input()); break;
    default: throw new Error([
      'Usage: personal-queue submit|list|status|run|dispatch|work|pause|resume|cancel|reconcile|resolve|verify|handoff|approve-check|check [id]',
      'Coordination: ready|progress|coordination|coordination-list|coordination-reconcile|notifications|admission|launch-reserve|launch-attach|launch-finalize [id]',
      'Coordinator only (role proof required): coord-approve|coord-deploy|coord-verify|coord-routing-policy|coord-machine-capacity|coord-authorize-external|coord-concurrency|coord-notify-delivered|coord-notify-ack [id]',
      'Input JSON uses stdin. State and results stay in the private queue directory.',
    ].join('\n'));
  }
  // Deliberately never print briefs, results, account details or verification evidence.
  console.log(JSON.stringify(Array.isArray(result) ? result : { id: result.id, status: result.status, revision: result.revision, owner: result.owner, sourceTask: result.sourceTask, launchId: result.launchId, resultHash: result.resultHash, reason: result.reason }, null, 2));
  if (result.status === 'blocked' || result.status === 'failed' || result.status === 'uncertain') process.exitCode = 2;
} catch (error) { console.error(error instanceof SyntaxError ? 'Invalid JSON; inspect the private input or queue state' : error.message); process.exitCode = 1; }
